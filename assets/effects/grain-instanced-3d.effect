// Converted 2026-08-24 from Unity ir/shaders/__Game_SDK_SandFlow_Material_GrainInstanced3D.shader
// (SandFlow/GrainInstanced3D) — P4a nhánh A, ad sand-drop-jar-fill.
// Sphere-impostor OPAQUE per-grain quad: fake half-lambert + micro-glint specular + per-grain jitter.
//
// KHONG DUNG GPU INSTANCING (khac ban Unity): Cocos ben nay dung 1 dynamic mesh gop toan bo hat cat
// (1 draw call) thay vi Graphics.RenderMeshInstanced. Vi vay:
//   - Mau per-hat: doc tu a_color (vertex attribute) thay vi UNITY_INSTANCING _Color instanced prop.
//   - Seed jitter per-hat (Unity doc UNITY_MATRIX_M._m03_m13_m23 = cot dich chuyen cua instance matrix):
//     doi thanh vertex attribute a_texCoord1.xyz = world-pos tam hat, GIONG NHAU cho ca 4 dinh cua 1 quad hat
//     (mesh-builder ben packages/sand-solver phai bake gia tri nay khi dung mesh). Hash13 giu nguyen trong GLSL
//     nen cong thuc jitter y het Unity, chi doi nguon seed.
CCEffect %{
techniques:
- name: opaque
  passes:
  - vert: grain3d-vs:vert
    frag: grain3d-fs:frag
    depthStencilState:
      depthTest: true
      depthWrite: true
    rasterizerState:
      cullMode: none
    blendState:
      targets:
      - blend: false
    properties:
      grainScale:      { value: 1.25, editor: { tooltip: "Grain Size (visual, doc lap radiusScale)", range: [0.1, 2] } }
      colorBrightness: { value: 1.5,  editor: { tooltip: "Color Brightness (do sang mau hat)", range: [0, 3] } }
      lightDir:        { value: [-0.5, 0.7, 0.6, 0], editor: { tooltip: "Light Dir (screen-space)" } }
      ambient:         { value: 0.386, editor: { tooltip: "Ambient (nen sang day)", range: [0, 1] } }
      specStrength:    { value: 0.528, editor: { tooltip: "Specular Strength", range: [0, 2] } }
      specPower:       { value: 24.0,  editor: { tooltip: "Specular Power", range: [1, 128] } }
      rimStrength:     { value: 0.0,   editor: { tooltip: "Rim Strength (0=tat)", range: [0, 1] } }
      brightJitter:    { value: 0.15,  editor: { tooltip: "Per-grain Brightness Jitter", range: [0, 0.5] } }
      grainTilt:       { value: 0.15,  editor: { tooltip: "Per-grain Normal Tilt", range: [0, 0.4] } }
      glintChance:     { value: 0.2,   editor: { tooltip: "Glint Chance (ti le hat lap lanh)", range: [0, 1] } }
}%

CCProgram grain3d-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;   // corner ±1 (giong Unity UV goc quad) -> mask tron + normal ban cau
  in vec4 a_color;      // mau per-hat (thay UNITY_INSTANCING _Color)
  // MESH GOP (P4b 2026-08-24): a_position = TAM hat (world), HANG SO cho ca 4 dinh -> dong thoi la seed Hash13,
  // dung dung vai tro cot dich chuyen cua UNITY_MATRIX_M ben Unity. Goc quad dung lai trong VS tu a_texCoord.
  // a_texCoord1.x = ban kinh hat (world). Nho vay grainScale van la knob material LIVE, khong phai rebuild mesh.
  in vec2 a_texCoord1;  // x = radius (world), yz = du tru

  out vec2 v_uv;
  out vec4 v_color;
  out vec4 v_grain; // xy = tilt normal, z = brightness mul, w = glint gate (0/1)

  uniform Constants {
    vec4 lightDir;
    float grainScale;
    float colorBrightness;
    float ambient;
    float specStrength;
    float specPower;
    float rimStrength;
    float brightJitter;
    float grainTilt;
    float glintChance;
  };

  // Hash 3D->1 (Dave Hoskins) — giu nguyen cong thuc Unity.
  float Hash13(vec3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
  }

  vec4 vert () {
    vec3 center = a_position;                       // tam hat, hang so 4 dinh
    float radius = a_texCoord1.x * grainScale;      // grainScale scale RIENG hat, KHONG scale bai cat
    vec3 posOS = center + vec3(a_texCoord * radius, 0.0);
    vec4 pos = cc_matWorld * vec4(posOS, 1.0);
    pos = cc_matViewProj * pos;

    v_uv = a_texCoord;
    v_color = a_color;

    vec3 seed = center;                             // = world-pos tam (nhu UNITY_MATRIX_M._m03_m13_m23)
    float h1 = Hash13(seed);
    float h2 = Hash13(seed + 17.0);
    float h3 = Hash13(seed + 43.0);
    v_grain.xy = (vec2(h1, h3) * 2.0 - 1.0) * grainTilt;
    v_grain.z  = 1.0 + (h3 * 2.0 - 1.0) * brightJitter;
    v_grain.w  = step(h2, glintChance);

    return pos;
  }
}%

CCProgram grain3d-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec2 v_uv;
  in vec4 v_color;
  in vec4 v_grain;

  uniform Constants {
    vec4 lightDir;
    float grainScale;
    float colorBrightness;
    float ambient;
    float specStrength;
    float specPower;
    float rimStrength;
    float brightJitter;
    float grainTilt;
    float glintChance;
  };

  vec4 frag () {
    float r2 = dot(v_uv, v_uv);
    if (r2 > 1.0) discard; // clip(1.0 - r2) -> chấm TRÒN opaque

    vec3 N = vec3(v_uv + v_grain.xy, sqrt(clamp(1.0 - r2, 0.0, 1.0)));
    N = normalize(N);
    vec3 L = normalize(lightDir.xyz);
    vec3 V = vec3(0.0, 0.0, 1.0);

    float ndl  = dot(N, L) * 0.5 + 0.5;
    float diff = ndl * ndl;
    float lit  = clamp(ambient + diff, 0.0, 1.0) * v_grain.z;

    vec3 H = normalize(L + V);
    float spec = pow(clamp(dot(N, H), 0.0, 1.0), specPower) * specStrength * v_grain.w;

    float rim = pow(1.0 - N.z, 3.0) * rimStrength;

    vec3 rgb = v_color.rgb * colorBrightness * lit + spec + rim;
    return vec4(rgb, 1.0);
  }
}%
