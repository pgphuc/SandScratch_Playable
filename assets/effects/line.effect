// Converted 2026-08-24 (P4a-A) from Unity ShaderGraph JSON:
// ir/shaders/__Game_SDK_Sand_Drop_Visualize_Shaders_Line.shadergraph
// (Shader Graphs/Line, UniversalLitSubTarget — Opaque surface, no Alpha block wired).
// Reconstructed node walk (see p4a-A-shadergraph-subreport.md):
//   scrollX = fract(Speed * cc_time.x)
//   uv2     = uv0 * vec2(1,1) [Tiling, unconnected default] + vec2(scrollX, 1.0) [Offset]
//   tex     = texture(mainTexture, uv2)
//   BaseColor = Blend_Lighten( vec3(0.5) [Base slot left unconnected, literal default],
//                               tex.rgb, Opacity=1 [unconnected default] )
//             = max(vec3(0.5), tex.rgb)
// APPROX: source is a Lit (PBR) sub-target, but the graph only ever drives BaseColor —
// Metallic/Smoothness/Occlusion/Emission/NormalTS are all left at Unity's literal defaults
// (0 / 0.5 / 1 / 0 / (0,0,1)), i.e. never authored per-pixel. Full PBR lighting is not worth
// porting for this thin scrolling line VFX, so this is written as UNLIT (BaseColor emitted
// directly) — closest visual approximation without pulling in Cocos's standard/surface
// lighting pipeline. If the line reads too flat/bright next to lit geometry in QC, revisit.
// No material instance found for this shadergraph in ir/materials.json — properties below use
// the ShaderGraph Blackboard defaults instead (Speed=1; Texture2D has no texture assigned in
// the source graph either, so mainTexture falls back to Cocos builtin "white").
// NOT compile-verified — Cocos editor was kept closed per task constraints.
CCEffect %{
techniques:
- name: opaque
  passes:
  - vert: line-vs:vert
    frag: line-fs:frag
    depthStencilState:
      depthTest: true
      depthWrite: true
    rasterizerState:
      cullMode: none
    blendState:
      targets:
      - blend: false
    properties:
      mainTexture: { value: white }
      speed:       { value: 1.0 }
}%

CCProgram line-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;

  out vec2 v_uv;

  vec4 vert () {
    vec4 pos = cc_matWorld * vec4(a_position, 1.0);
    pos = cc_matViewProj * pos;
    v_uv = a_texCoord;
    return pos;
  }
}%

CCProgram line-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec2 v_uv;

  uniform sampler2D mainTexture;

  uniform Constants {
    float speed;
  };

  vec4 frag () {
    // ShaderGraph "Fraction( Multiply(Speed, Time) )" feeding Offset.x, Tiling left at default (1,1).
    float scrollX = fract(speed * cc_time.x);
    vec2 uv2 = v_uv * vec2(1.0, 1.0) + vec2(scrollX, 1.0);

    vec3 tex = texture(mainTexture, uv2).rgb;

    // ShaderGraph Blend node, mode index 8 = Lighten: max(Base, Blend). Base slot unconnected
    // (literal vec4(0.5)), Opacity slot unconnected (literal 1.0) so it's a pure max().
    vec3 col = max(vec3(0.5), tex);

    return vec4(col, 1.0);
  }
}%
