// Converted 2026-08-24 from Unity ir/shaders/__Game_SDK_SandFlow_Material_ObiFlatGrainParticles.shader
// (SandFlow/FlatGrainParticles) — P4a nhánh A, ad sand-drop-jar-fill.
// Unlit view-space billboard disc + vành mềm cùng màu, cho mesh hạt kiểu Obi ParticleVertex (BURST layout):
//   POSITION = center, NORMAL = góc billboard (±1,±1,0), COLOR = màu per-hạt, TEXCOORD0.xyz = trục orient,
//   TEXCOORD0.w = RADIUS hạt. Layout này ĐÃ per-vertex (không dùng GPU instancing ở Unity) nên giữ NGUYÊN
//   attribute mapping — không cần đổi gì cho merged-mesh (1 draw call vẫn hoạt động y hệt, mỗi hạt vẫn là
//   1 quad riêng trong cùng 1 mesh/vertex buffer).
// KHONG TIM THAY material instance nao dung shader nay trong ir/materials.json -> default value lay tu
// Properties block ShaderLab goc (KHONG bia).
// APPROX: bo qua truc orientation TEXCOORD0.xyz (khong dung trong billboard view-space cua Unity source
// nay — code Unity cung KHONG dung no, chi doc .w). Giu comment de khong mat thong tin field goc.
CCEffect %{
techniques:
- name: transparent
  passes:
  - vert: obiflatgrain-vs:vert
    frag: obiflatgrain-fs:frag
    depthStencilState:
      depthTest: true
      depthWrite: false
    rasterizerState:
      cullMode: none
    blendState:
      targets:
      - blend: true
        blendSrc: src_alpha
        blendDst: one_minus_src_alpha
        blendDstAlpha: one_minus_src_alpha
    properties:
      particleColor: { value: [1, 1, 1, 1], editor: { type: color, tooltip: "Particle Color (tint)" } }
      grainScale:    { value: 0.75, editor: { tooltip: "Grain Size (visual, doc lap radiusScale)", range: [0.1, 2] } }
      borderWidth:   { value: 0.25, editor: { tooltip: "Border Width (ti le ban kinh)", range: [0, 1] } }
      borderAlpha:   { value: 0.4,  editor: { tooltip: "Border Alpha (do mo vanh)", range: [0, 1] } }
}%

CCProgram obiflatgrain-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;   // center hat (object space)
  in vec3 a_normal;     // corner billboard (±1,±1,0) — tai su dung NORMAL semantic giong Unity source
  in vec4 a_color;      // mau per-hat
  in vec4 a_texCoord;   // .xyz = truc orientation (khong dung, xem APPROX) .w = RADIUS hat

  out vec4 v_color;
  out vec2 v_uv;

  uniform Constants {
    vec4 particleColor;
    float grainScale;
    float borderWidth;
    float borderAlpha;
  };

  vec4 vert () {
    vec4 posWS = cc_matWorld * vec4(a_position, 1.0);
    vec4 posVS = cc_matView * posWS;
    float radius = a_texCoord.w * grainScale;
    posVS.xy += a_normal.xy * radius;
    vec4 pos = cc_matProj * posVS;

    v_uv = a_normal.xy;
    v_color = a_color * particleColor;
    return pos;
  }
}%

CCProgram obiflatgrain-fs %{
  precision highp float;

  in vec4 v_color;
  in vec2 v_uv;

  uniform Constants {
    vec4 particleColor;
    float grainScale;
    float borderWidth;
    float borderAlpha;
  };

  vec4 frag () {
    float r = length(v_uv);
    if (r > 1.0) discard;

    float coreEdge = 1.0 - borderWidth;
    // fwidth() = derivative -> o path #version 100 Cocos sinh code can GL_OES_standard_derivatives, ma
    // extension nay BI TAT -> EFX2406 (verify 2026-08-24 tu temp/logs/project.log).
    // GLES3 (WebGL2) van dung fwidth that; GLES2 fallback AA co dinh -> APPROX, mep hat hoi cung hon.
    #if __VERSION__ >= 300
      float aa = max(fwidth(r), 1e-5);
    #else
      float aa = 0.03;
    #endif
    float core  = 1.0 - smoothstep(coreEdge - aa, coreEdge + aa, r);
    float outer = 1.0 - smoothstep(1.0 - aa, 1.0, r);
    float a = mix(borderAlpha, 1.0, core) * outer;

    return vec4(v_color.rgb, a);
  }
}%
